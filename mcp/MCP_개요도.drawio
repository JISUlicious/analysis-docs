<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0">
  <diagram id="mcp-overview" name="MCP 개요도">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="MCP(Model Context Protocol) 개요 — Host · Client · Server" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="640" height="30" as="geometry" />
        </mxCell>

        <mxCell id="nxm" value="해결하는 문제: 통합 폭발&#10;표준화 전 = 앱 N × 대상 M 개의 커스텀 통합&#10;표준화 후 = 앱은 클라이언트 1회, 대상은 서버 1회 (N+M)&#10;→ 서버는 어느 호스트에서든 재사용" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="10" width="380" height="80" as="geometry" />
        </mxCell>

        <mxCell id="host" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#6c8ebf;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="20" y="110" width="340" height="440" as="geometry" />
        </mxCell>
        <mxCell id="host_label" value="HOST 애플리케이션&#10;(Claude Desktop · IDE · ADK 에이전트 앱)&#10;— 보안·사용자 동의·권한의 주체" style="text;html=1;strokeColor=none;fillColor=none;align=center;whiteSpace=wrap;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="118" width="320" height="56" as="geometry" />
        </mxCell>
        <mxCell id="llm" value="LLM&#10;(추론·도구 호출 결정)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="185" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="MCP Client #1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="270" width="280" height="45" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="MCP Client #2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="360" width="280" height="45" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="MCP Client #3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="450" width="280" height="45" as="geometry" />
        </mxCell>
        <mxCell id="ratio" value="클라이언트 : 서버 = 1 : 1&#10;(서버 수만큼 클라이언트 생성)" style="text;html=1;strokeColor=none;fillColor=none;align=center;whiteSpace=wrap;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="320" width="280" height="30" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="MCP Server: filesystem&#10;(로컬 · 서브프로세스)&#10;──────────&#10;Tools · Resources · Prompts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="560" y="250" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="MCP Server: database&#10;(로컬 · 서브프로세스)&#10;──────────&#10;Tools · Resources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="560" y="342" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="MCP Server: SaaS 연동&#10;(원격 · HTTP 엔드포인트, OAuth 2.1)&#10;──────────&#10;Tools · Resources · Prompts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="560" y="434" width="230" height="80" as="geometry" />
        </mxCell>

        <mxCell id="x1" value="로컬 파일" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="880" y="262" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="x2" value="DB" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="880" y="348" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="x3" value="외부 API / SaaS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="880" y="446" width="150" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="stdio&#10;(JSON-RPC 2.0)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;fontSize=10;" edge="1" parent="1" source="c1" target="s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="stdio&#10;(JSON-RPC 2.0)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;fontSize=10;" edge="1" parent="1" source="c2" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="Streamable HTTP&#10;(JSON-RPC 2.0)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;fontSize=10;" edge="1" parent="1" source="c3" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="s1" target="x1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="s2" target="x2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="s3" target="x3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="back" value="클라이언트 프리미티브 (역방향: 서버가 호스트 능력을 빌림)&#10;· Sampling — 서버가 호스트의 LLM 호출을 요청&#10;· Roots — 호스트가 작업 범위(디렉터리 등) 제공&#10;· Elicitation — 서버가 사용자에게 추가 입력/확인 요청" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="580" width="390" height="90" as="geometry" />
        </mxCell>
        <mxCell id="roles" value="역할 요약&#10;· Host — LLM을 품은 애플리케이션 (조율·보안)&#10;· Client — Host 내부, 서버와 1:1 연결 유지&#10;· Server — 도구·데이터·프롬프트를 표준 형식으로 노출&#10;서버 프리미티브: Tools(모델 제어) / Resources(앱 제어) / Prompts(사용자 제어)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="580" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="backedge" value="Sampling / Elicitation / Roots" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#82b366;fontColor=#82b366;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="c3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="470" y="530" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
