<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0">
  <diagram id="mcp-structure" name="MCP 구조도">
    <mxGraphModel dx="1200" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="MCP 구조 — 프로토콜 계층 · 프리미티브 · 세션 라이프사이클 · ADK 매핑" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="760" height="30" as="geometry" />
        </mxCell>

        <mxCell id="stack_label" value="① 프로토콜 계층" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="50" width="200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="layer_data" value="데이터 계층 (전송과 무관하게 동일)&#10;· 라이프사이클: initialize / capability 협상 / initialized&#10;· 프리미티브: tools · resources · prompts / sampling · roots · elicitation&#10;· 알림: notifications/*/list_changed, progress, logging" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="layer_rpc" value="JSON-RPC 2.0  (요청 / 응답 / 알림 · stateful 세션)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="170" width="420" height="36" as="geometry" />
        </mxCell>
        <mxCell id="layer_tr" value="전송 계층 (교체 가능)&#10;stdio (로컬·서브프로세스)   |   Streamable HTTP (원격, 2025-03-26~)   |   HTTP+SSE (legacy)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="206" width="420" height="50" as="geometry" />
        </mxCell>

        <mxCell id="prim_label" value="② 프리미티브 (capability 협상된 것만 사용 가능)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="50" width="400" height="24" as="geometry" />
        </mxCell>
        <mxCell id="prim_srv" value="서버 프리미티브 (서버 → 호스트)&#10;&#10;Tools — 모델이 호출 결정 (model-controlled)&#10;    tools/list · tools/call · inputSchema(JSON Schema)&#10;Resources — 앱이 선택 (app-controlled)&#10;    resources/list · resources/read · subscribe · URI 식별&#10;Prompts — 사용자가 선택 (user-controlled)&#10;    prompts/list · prompts/get" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="480" y="80" width="340" height="176" as="geometry" />
        </mxCell>
        <mxCell id="prim_cli" value="클라이언트 프리미티브 (호스트 → 서버 제공)&#10;&#10;Sampling — 서버가 호스트 LLM 호출을 요청&#10;Roots — 작업 범위(디렉터리 등) 통지&#10;Elicitation — 실행 중 사용자 입력/확인 요청&#10;&#10;(SDK ClientSession: sampling_callback ·&#10; list_roots_callback · elicitation_callback)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="840" y="80" width="340" height="176" as="geometry" />
        </mxCell>

        <mxCell id="lc_label" value="③ 세션 라이프사이클 (Client ↔ Server)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;" vertex="1" parent="1">
