          <mxGeometry x="20" y="450" width="1160" height="270" as="geometry" />
        </mxCell>
        <mxCell id="adk_ts" value="McpToolset (BaseToolset)&#10;──────────────&#10;get_tools() → tools/list 후&#10;각 도구를 McpTool로 변환&#10;read/list_resources() → resources/*&#10;tool_filter · get_auth_config()&#10;close() ← Runner.close()가 일괄 호출" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="485" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="adk_sm" value="MCPSessionManager&#10;──────────────&#10;ClientSession 생성·캐시·재연결&#10;연결 파라미터 3종:&#10;· StdioConnectionParams&#10;· SseConnectionParams (legacy)&#10;· StreamableHTTPConnectionParams" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="360" y="485" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="adk_tool" value="McpTool (BaseAuthenticatedTool)&#10;──────────────&#10;_get_declaration():&#10;  MCP inputSchema → FunctionDeclaration&#10;  (conversion_utils)&#10;run_async():&#10;  ADK 인증(헤더) → session.call_tool()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="680" y="485" width="290" height="150" as="geometry" />
        </mxCell>
        <mxCell id="adk_note" value="mcp SDK&#10;1.29.0 실측:&#10;최신 프로토콜&#10;리비전&#10;2025-11-25" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1000" y="485" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="adk_flow" value="에이전트 flow와의 접점: MCP 도구도 BaseTool → 함수콜 실행 경로(handle_function_calls_async)·toolset 라이프사이클(수집·close)을 그대로 따름.&#10;1.26.0 기준 tools 1급 + resources 보조, prompts 미노출. elicitation 콜백은 1.26.0 이후(48246195) 추가." style="text;html=1;strokeColor=none;fillColor=none;align=left;whiteSpace=wrap;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="1120" height="55" as="geometry" />
