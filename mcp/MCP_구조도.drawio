        <mxCell id="l1" value="initialize 요청&#10;(프로토콜 버전 +&#10;클라이언트 capability)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
