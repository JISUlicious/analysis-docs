        <mxCell id="adk_label" value="④ ADK(google-adk 1.26.0)의 MCP 호스트 구현 매핑" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;" vertex="1" parent="1">
